# Staso
STASO_API_KEY=
STASO_API_URL=https://api.staso.ai
STASO_ENV=default

# Claude Code paths (auto-detected if empty)
# SKILLS_DIR defaults to .claude/skills in cwd
# MEMORY_DIR defaults to ~/.claude/projects/-<cwd-slug>/memory/
SKILLS_DIR=
MEMORY_DIR=

# LLM provider: auto | claude-code | openrouter | deepseek
# claude-code uses local CLI (free, your subscription)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Models (OpenRouter IDs)
# Cheapest:     google/gemini-2.0-flash-001   $0.10/M  1M ctx — reliable JSON extraction
# Good default: deepseek/deepseek-chat        $0.14/M  128K   — solid all-rounder
# Thinking:     google/gemini-2.5-flash       $0.30/M  1M ctx — best cross-session analysis
# Reasoning:    deepseek/deepseek-r1-0528     $0.50/M  164K   — deep pattern detection
# Premium:      anthropic/claude-sonnet-4     $3.00/M  1M ctx — highest quality
LLM_MODEL=deepseek/deepseek-chat

# Per-pass model overrides (optional, falls back to LLM_MODEL)
# Per-session is just structured extraction — use a cheap/fast model
# Cross-session is pattern detection — use a stronger model
LLM_MODEL_PER_SESSION=google/gemini-2.0-flash-001
LLM_MODEL_CROSS_SESSION=google/gemini-2.5-flash
